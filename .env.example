# ── Supabase ──────────────────────────────────────────────
# Založ projekt na https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...        # anon key (veřejný, je ok na klientu)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...            # service-role — JEN NA SERVERU, nikdy do klienta!

# ── Mapa (volitelné) ──────────────────────────────────────
# Podklad zdarma: OpenStreetMap dlaždice (bez klíče) NEBO Mapy.com turistická vrstva.
# Mapy.com klíč (hezčí české + rakouské řeky): https://developer.mapy.com
# NEXT_PUBLIC_MAPY_API_KEY=...        # volitelné; bez něj jede OSM podklad
# Overlay OpenSeaMap (bóje, přístavy, vodní cesty) je bez klíče.


# ── Fáze 2 (AIS lodě) — až později ────────────────────────
# AISSTREAM_API_KEY=...                           # https://aisstream.io (zdarma)
